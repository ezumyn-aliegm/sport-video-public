PORT=3000
# Compose sets NODE_ENV=production; the placeholder below is rejected there.
SESSION_SECRET=change-me-in-production
# Set true only when a controlled reverse proxy terminates TLS before this app.
TRUST_PROXY=false
# Generate with: node ./scripts/hash-pin.js 1234
# Paste the full FAMILY_PIN_HASH=... assignment emitted by the script.
FAMILY_PIN_HASH=
YOUTUBE_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_SELF_DECLARED_MADE_FOR_KIDS=true
MAX_UPLOAD_MB=500
# Aggregate private-QA upload storage cap; new uploads are rejected when full.
MAX_UPLOAD_STORAGE_MB=2048
DB_PATH=./data/sport-video.db
